# Local Gemini API key. Do not commit real values.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Google Cloud project used by the Cloud Run deployment script.
GCP_PROJECT_ID=your-google-cloud-project-id
GCP_REGION=us-central1
SERVICE_NAME=treasury-risk-analyzer

# Optional: Gemini model used for extraction and DeepEval judging.
GEMINI_MODEL=gemini-3.8-flash
